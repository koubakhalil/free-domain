<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome to My Domain</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            background-color: #0d1117;
            color: #c9d1d9;
            text-align: center;
            padding: 20px;
        }
        .container {
            max-width: 600px;
            background: #161b22;
            padding: 40px;
            border-radius: 12px;
            border: 1px solid #30363d;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
        }
        h1 {
            color: #58a6ff;
            margin-bottom: 12px;
            font-size: 2rem;
        }
        p {
            color: #8b949e;
            font-size: 1.1rem;
            margin-bottom: 24px;
        }
        .contact-btn {
            display: inline-block;
            padding: 10px 20px;
            background-color: #238636;
            color: #ffffff;
            text-decoration: none;
            border-radius: 6px;
            font-weight: 600;
            transition: background-color 0.2s;
        }
        .contact-btn:hover {
            background-color: #2ea043;
        }
    </style>
</head>
<body>

    <div class="container">
        <h1>Welcome</h1>
        <p>This site is hosted on GitHub Pages.</p>
        <!-- Replace your email below -->
        <a href="mailto:contact@yourcustomdomain.com" class="contact-btn">Contact Me</a>
    </div>

</body>
</html>
